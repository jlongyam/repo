{
  "name": "@jlongyam/repo",
  "version": "1.0.1",
  "description": "Repository Utility",
  "keywords": [
    "repo",
    "repository"
  ],
  "author": "jlongyam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/repo.git"
  },
  "homepage": "https://github.com/jlongyam/repo",
  "license": "MIT",
  "dependencies": {
    "clean-modules": "^3.1.1",
    "es-check": "^9.5.4",
    "semver": "^7.7.4"
  },
  "main": "index.js",
  "type": "module",
  "bin": {
    "repo": "cli/repo.js"
  },
  "scripts": {
    "changelog": "./cli/repo.js changelog",
    "clean": "./cli/repo.js clean",
    "escheck": "./cli/repo.js escheck ./src/changelog.js ./src/clean.js ./src/escheck.js ./index.js",
    "prepublish": "npm publish --dry-run"
  },
  "exports": {
    "default": "./index.js"
  },
  "files": [
    "./src",
    "./cli",
    "./docs",
    "./LICENSE",
    "./README.md",
    "./CHANGELOG.MD"
  ],
  "publishConfig": {
    "access": "public"
  }
}
