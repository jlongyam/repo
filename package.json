{
  "name": "@jlongyam/repo",
  "version": "2.1.1",
  "description": "Repository Utility",
  "keywords": [
    "repo",
    "repository"
  ],
  "author": "jlongyam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/repo.git"
  },
  "homepage": "https://github.com/jlongyam/repo",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "bin": {
    "repo": "cli/repo.js"
  },
  "dependencies": {
    "es-check": "^9.5.4",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "changelog": "./cli/repo.js changelog",
    "clean": "./cli/repo.js clean",
    "prepublish": "npm publish --dry-run",
    "escheck": "./cli/repo.js escheck ./src/changelog.js ./src/clean.js ./src/escheck.js ./index.js",
    "rollup": "rollup -c",
    "ts": "tsc"
  },
  "exports": {
    "default": "./index.js"
  },
  "types": "./index.d.ts",
  "files": [
    "./src",
    "./cli",
    "./docs",
    "./LICENSE",
    "./README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
