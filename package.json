{
  "name": "@jlongyam/repo",
  "version": "0.3.1",
  "description": "ES6 Monorepo Builder CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/repo.git"
  },
  "keywords": [
    "monorepo",
    "builder",
    "cli",
    "es6"
  ],
  "author": "jlongyam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jlongyam/repo/issues"
  },
  "homepage": "https://github.com/jlongyam/repo",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "repo": "./bin/repo.js"
  },
  "scripts": {
    "start": "node bin/repo.js",
    "dev": "node --watch bin/repo.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest tests/e2e/",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "test:unit": "npm run test -- tests/unit/",
    "test:integration": "npm run test -- tests/integration/",
    "test:ci": "npm run test -- --ci --coverage"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dependency-graph": "^0.11.0",
    "dotenv": "^17.2.3",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "mock-fs": "^5.2.0",
    "tempy": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
